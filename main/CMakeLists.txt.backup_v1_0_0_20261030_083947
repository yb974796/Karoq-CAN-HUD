# V1.0 integrated; native main component, categorized modules.
# Only ui/legacy and other/project_legacy are imported from your REAL V0.5-V0.10 project.
# Never compile old V0.8 overlay or legacy duplicate CAN decoders.
file(GLOB KAROQ_LEGACY_UI_SRCS CONFIGURE_DEPENDS
     "${CMAKE_CURRENT_LIST_DIR}/ui/legacy/*.c")
file(GLOB KAROQ_ORIGINAL_PROBE_SRCS CONFIGURE_DEPENDS
     "${CMAKE_CURRENT_LIST_DIR}/other/probes/*.c")
file(GLOB KAROQ_OTHER_SRCS CONFIGURE_DEPENDS
     "${CMAKE_CURRENT_LIST_DIR}/other/project_legacy/*.c")

idf_component_register(
    SRCS
        "core/main.c"
        "id/can/karoq_can_sniffer.c"
        "id/decoders/karoq_can_speed.c"
        "id/decoders/karoq_can_acc_probe.c"
        "ui/bridge/karoq_hud_speed_bridge.c"
        "ui/guard/karoq_hud_speed_guard.c"
        ${KAROQ_LEGACY_UI_SRCS}
        ${KAROQ_ORIGINAL_PROBE_SRCS}
        ${KAROQ_OTHER_SRCS}
    INCLUDE_DIRS
        "." "core" "id/can" "id/decoders" "id/types"
        "ui/legacy" "ui/bridge" "ui/guard"
        "other/probes" "other/project_legacy" "other/include"
    PRIV_REQUIRES
        esp_driver_twai
        esp_timer
        i2c_bsp
        lcd_bl_pwm_bsp
        esp_lcd
        lvgl
        espressif__esp_lcd_axs15231b
        espressif__esp_io_expander_tca9554
        espressif__esp_lcd_touch
)

set_source_files_properties(
    ${LV_DEMOS_SOURCES}
    PROPERTIES COMPILE_OPTIONS
    -DLV_LVGL_H_INCLUDE_SIMPLE
)
